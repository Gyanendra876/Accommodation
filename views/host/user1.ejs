<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
  
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col">

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <!-- Main Content -->
  <main class="flex-grow flex justify-center items-center px-4 py-12">
    <div class="bg-white/80 backdrop-blur-sm shadow-lg border border-gray-100 rounded-2xl w-full max-w-lg p-8">

      <!-- Title -->
      <h1 class="flex items-center justify-center gap-2 text-2xl sm:text-3xl font-bold text-gray-800 mb-8">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="w-6 h-6 text-pink-600">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Add New Home 🏡
      </h1>

      <!-- Form -->
      <form action="/host/add-home" method="POST" class="space-y-5">

        <!-- House Name -->
        <input type="text" name="houseName" placeholder="Enter the name of your house" required
          class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none" />

        <!-- Price -->
        <input type="text" name="pricepernight" placeholder="Enter the price" required
          class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none" />

        <!-- Location -->
        <input type="text" name="Location" placeholder="Enter the location" required
          class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none" />

        <!-- Rating -->
        <input type="text" name="Rating" placeholder="Enter the rating" required
          class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none" />

        <!-- Photo URL -->
        <input type="text" name="photourl" placeholder="Enter the photo URL" required
          class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none" />

        <!-- Submit Button -->
        <button type="submit"
          class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-pink-500 to-red-500 text-white font-semibold py-3 rounded-xl shadow-md hover:shadow-lg hover:scale-[1.02] transition-all duration-200">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Submit
        </button>
      </form>
    </div>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>
</body>
</html>
