<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
  
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 font-[Poppins] text-gray-700">
  <!-- Navbar -->
  <%- include('../partials/nav')%>

  <!-- Success Message Container -->
  <div class="flex flex-1 items-center justify-center px-4 py-16">
    <div class="bg-white shadow-lg rounded-2xl p-8 max-w-md w-full text-center border border-gray-100">
      
      <!-- Success Icon -->
      <div class="flex justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <!-- Heading -->
      <h1 class="text-2xl font-semibold text-gray-800 mb-2">Registered Successfully</h1>
      <p class="text-gray-500 mb-6">Your account has been created successfully.</p>

      <!-- Home Link -->
      <a href="/" class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-800 font-medium transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Go To Home
      </a>
    </div>
  </div>

  <!-- Footer -->
  <%- include('../partials/footer')%>
</body>
</html>
