<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
  
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-pink-50 via-white to-yellow-50 text-gray-800 min-h-screen">
  <%- include('../partials/nav') %>

  <!-- Added top spacing below navbar -->
  <div class="mt-20"></div>

  <main class="container mx-auto px-4 py-12">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-center mb-12 text-gray-800">
      🏠 Your Listed Homes
    </h1>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <% Registration.forEach(home => { %>
        <div class="bg-white shadow-lg rounded-2xl overflow-hidden border border-gray-200 hover:shadow-2xl hover:scale-[1.02] transition-all duration-300 ease-in-out">
          
          <!-- Image -->
          <div class="relative">
            <img src="<%= home.photourl %>" alt="<%= home.houseName %>" 
                 class="w-full h-52 object-cover" />
            <span class="absolute top-3 right-3 bg-white/90 text-gray-800 text-sm px-3 py-1 rounded-full font-medium shadow">
              ⭐ <%= home.Rating %>
            </span>
          </div>

          <!-- Content -->
          <div class="p-6 space-y-3">

            <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" 
                   class="w-5 h-5 text-pink-500">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 17.75L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
              <%= home.houseName %>
            </h2>

            <p class="text-gray-600 text-sm flex items-center gap-1">
              📍 <span><%= home.Location %></span>
            </p>

            <p class="text-gray-900 font-semibold text-lg">
              ₹<%= home.pricepernight %> <span class="text-sm font-normal text-gray-600">/ night</span>
            </p>

            <!-- Buttons -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
              <a href="/host/edit-home/<%= home._id %>?editing=true"
                 class="flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition duration-200">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" 
                     class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round"
                        d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-2.828 0L5 11.828a2 2 0 010-2.828L11.828 2.172a2 2 0 012.828 0z" />
                </svg>
                Edit
              </a>

              <form action="/host/delete-item/<%= home._id %>" method="POST" class="inline">
                <button type="submit"
                        class="flex items-center gap-2 text-red-500 hover:text-red-700 font-medium transition duration-200">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" 
                       class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  Delete
                </button>
              </form>
            </div>

          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
