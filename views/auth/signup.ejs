<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-pink-100 via-yellow-100 to-red-100 font-poppins flex flex-col">
  <%- include('../partials/nav') %>

  <!-- Signup Form -->
  <div class="flex flex-1 items-center justify-center pt-28 pb-10 px-4">
    <div class="bg-white bg-opacity-90 rounded-lg shadow-lg p-8 w-full max-w-md">
      <h1 class="text-3xl font-bold text-center text-pink-600 mb-6 flex items-center justify-center">
        <svg class="w-7 h-7 mr-2 text-pink-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v6m3-3h-6m-2 4a4 4 0 100-8 4 4 0 000 8z"/>
        </svg>
        Signup
      </h1>

      <% if(errors.length > 0) { %>
        <ul class="mb-4">
          <% errors.forEach(error => { %>
            <li class="text-red-500 text-sm flex items-center">
              <svg class="w-4 h-4 mr-1 text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12A9 9 0 113 12a9 9 0 0118 0z"/>
              </svg>
              <%= error %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <form action="/signup" method="POST" class="space-y-4">
        <input type="text" name="firstName" placeholder="First Name" required class="w-full px-4 py-2 border border-pink-300 rounded focus:ring-2 focus:ring-pink-400 focus:outline-none" />
        <input type="text" name="lastname" placeholder="Last Name" class="w-full px-4 py-2 border border-pink-300 rounded focus:ring-2 focus:ring-pink-400 focus:outline-none" />
        <input type="email" name="email" placeholder="Email" required class="w-full px-4 py-2 border border-pink-300 rounded focus:ring-2 focus:ring-pink-400 focus:outline-none" />
        <input type="password" name="password" placeholder="Password" required class="w-full px-4 py-2 border border-pink-300 rounded focus:ring-2 focus:ring-pink-400 focus:outline-none" />
        <input type="password" name="confirmpassword" placeholder="Confirm Password" required class="w-full px-4 py-2 border border-pink-300 rounded focus:ring-2 focus:ring-pink-400 focus:outline-none" />

        <div>
          <label class="block mb-1 font-medium text-pink-600">User Type</label>
          <div class="flex gap-6">
            <label class="flex items-center">
              <input type="radio" name="userType" value="host" required class="text-pink-500 focus:ring-pink-400" />
              <span class="ml-2">Host</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="userType" value="guest" required class="text-pink-500 focus:ring-pink-400" />
              <span class="ml-2">Guest</span>
            </label>
          </div>
        </div>

        <label class="flex items-center text-sm text-gray-700">
          <input type="checkbox" name="terms" required class="text-pink-500 focus:ring-pink-400">
          <span class="ml-2">I agree to the terms and conditions</span>
        </label>

        <button type="submit" class="w-full flex items-center justify-center bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 rounded transition">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v6m3-3h-6m-2 4a4 4 0 100-8 4 4 0 000 8z"/>
          </svg>
          Signup
        </button>
      </form>
    </div>
  </div>
</body>
</html>
