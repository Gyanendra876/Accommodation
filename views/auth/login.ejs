<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-pink-100 via-yellow-100 to-red-100 flex flex-col">
  
  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <!-- Main Login Section -->
  <div class="flex flex-1 items-center justify-center px-4 sm:px-0 mt-20 sm:mt-24">
    <div class="bg-white bg-opacity-90 rounded-lg shadow-lg p-8 w-full max-w-md">
      <h1 class="text-3xl font-bold text-center text-pink-600 mb-6 flex items-center justify-center">
        <svg class="w-7 h-7 mr-2 text-pink-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M15 12H3m0 0l4-4m-4 4l4 4m13-4a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Login
      </h1>

      <% if (errors.length > 0) { %>
      <ul class="mb-4">
        <% errors.forEach(error => { %>
          <li class="text-red-500 text-sm flex items-center">
            <svg class="w-4 h-4 mr-1 text-red-400" fill="none" stroke="currentColor" stroke-width="2"
                 viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 8v4m0 4h.01M21 12A9 9 0 113 12a9 9 0 0118 0z"/>
            </svg>
            <%= error %>
          </li>
        <% }) %>
      </ul>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        <div>
          <input type="email" name="email" placeholder="Enter the Email" required
                 class="w-full px-4 py-2 border border-pink-300 rounded focus:outline-none focus:ring-2 focus:ring-pink-400" />
        </div>
        <div>
          <input type="password" name="password" placeholder="Enter the Password" required
                 class="w-full px-4 py-2 border border-pink-300 rounded focus:outline-none focus:ring-2 focus:ring-pink-400" />
        </div>
        <div>
          <button type="submit"
                  class="w-full flex items-center justify-center bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-4 rounded transition">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
            Sign-In
          </button>
        </div>
      </form>
    </div>
  </div>

</body>
</html>
