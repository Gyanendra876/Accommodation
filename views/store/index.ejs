<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-[Poppins] bg-gray-50 text-gray-700 leading-relaxed">
  <%- include('../partials/nav')%>

  <!-- Container -->
  <div class="max-w-6xl mx-auto px-4 py-10 flex flex-col items-center mt-24">

    <!-- Carousel -->
    <div class="relative w-full max-w-5xl overflow-hidden rounded-2xl shadow-lg mb-10">
      <div class="carousel-slide active">
        <img src="/images/image1.jfif" alt="Home 1" class="w-full h-[450px] object-cover">
        <div class="absolute bottom-6 left-6 bg-white/80 text-gray-800 px-4 py-2 rounded-lg shadow">
          Find your dream stay in beautiful locations
        </div>
      </div>
      <div class="carousel-slide hidden">
        <img src="/images/image2.jpg" alt="Home 2" class="w-full h-[450px] object-cover">
        <div class="absolute bottom-6 left-6 bg-white/80 text-gray-800 px-4 py-2 rounded-lg shadow">
          Book instantly & securely with Staynest
        </div>
      </div>
      <div class="carousel-slide hidden">
        <img src="/images/images3.jpg" alt="Home 3" class="w-full h-[450px] object-cover">
        <div class="absolute bottom-6 left-6 bg-white/80 text-gray-800 px-4 py-2 rounded-lg shadow">
          Host your property & earn extra income
        </div>
      </div>
      <!-- Dots -->
      <div class="flex justify-center gap-2 mt-3">
        <span class="dot w-3 h-3 bg-indigo-500 rounded-full"></span>
        <span class="dot w-3 h-3 bg-gray-300 rounded-full"></span>
        <span class="dot w-3 h-3 bg-gray-300 rounded-full"></span>
      </div>
    </div>

    <!-- Hero -->
    <h1 class="text-3xl md:text-4xl font-bold text-indigo-800 text-center mb-2">Welcome to Staynest</h1>
    <p class="text-center max-w-2xl text-gray-600 mb-10">
      Discover, book, and manage your dream stays with ease.
      Staynest brings you the best homes, seamless booking, and secure payments—all in one place.
    </p>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
      <div class="bg-white shadow-md rounded-xl p-6 text-center hover:-translate-y-1 transition">
        <h3 class="text-xl font-semibold text-indigo-700 mb-2">Browse Unique Homes</h3>
        <p>Explore a curated list of beautiful homes in amazing locations.</p>
      </div>
      <div class="bg-white shadow-md rounded-xl p-6 text-center hover:-translate-y-1 transition">
        <h3 class="text-xl font-semibold text-indigo-700 mb-2">Easy Booking</h3>
        <p>Book your favorite home in just a few clicks with instant confirmation.</p>
      </div>
      <div class="bg-white shadow-md rounded-xl p-6 text-center hover:-translate-y-1 transition">
        <h3 class="text-xl font-semibold text-indigo-700 mb-2">Secure Payments</h3>
        <p>Pay safely online with integrated Razorpay and enjoy peace of mind.</p>
      </div>
    </div>

    <!-- Stats -->
    <div class="text-center mb-14 w-full">
      <h2 class="text-2xl font-semibold text-indigo-800 mb-6">Staynest in Numbers</h2>
      <div class="flex flex-wrap justify-center gap-6">
        <div class="bg-white p-6 rounded-xl shadow-md w-44">
          <span class="text-2xl font-semibold text-indigo-600">1200+</span>
          <p>Homes Listed</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md w-44">
          <span class="text-2xl font-semibold text-indigo-600">3500+</span>
          <p>Bookings Made</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md w-44">
          <span class="text-2xl font-semibold text-indigo-600">1800+</span>
          <p>Happy Guests</p>
        </div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="text-center mb-14 w-full">
      <h2 class="text-2xl font-semibold text-indigo-800 mb-6">How It Works</h2>
      <div class="flex flex-wrap justify-center gap-8">
        <div class="bg-white w-28 h-28 rounded-full shadow-md flex flex-col items-center justify-center">
          <span class="text-indigo-600 font-bold text-lg">1</span>
          <p class="text-sm">Sign Up or Login</p>
        </div>
        <div class="bg-white w-28 h-28 rounded-full shadow-md flex flex-col items-center justify-center">
          <span class="text-indigo-600 font-bold text-lg">2</span>
          <p class="text-sm">Find Your Stay</p>
        </div>
        <div class="bg-white w-28 h-28 rounded-full shadow-md flex flex-col items-center justify-center">
          <span class="text-indigo-600 font-bold text-lg">3</span>
          <p class="text-sm">Book & Pay</p>
        </div>
      </div>
    </div>

    <!-- Testimonials -->
    <div class="text-center mb-14 w-full">
      <h2 class="text-2xl font-semibold text-indigo-800 mb-6">What Our Users Say</h2>
      <div class="flex flex-wrap justify-center gap-6">
        <div class="bg-white shadow-md rounded-xl p-6 max-w-sm">
          <p class="italic text-gray-600">"Staynest made my vacation planning so easy and stress-free. Highly recommended!"</p>
          <span class="block mt-2 text-indigo-700 font-medium">— Priya S.</span>
        </div>
        <div class="bg-white shadow-md rounded-xl p-6 max-w-sm">
          <p class="italic text-gray-600">"The payment process was smooth and I found the perfect home for my family."</p>
          <span class="block mt-2 text-indigo-700 font-medium">— Rahul M.</span>
        </div>
      </div>
    </div>

    <!-- Host Promo -->
    <div class="bg-white shadow-md rounded-2xl text-center p-8 max-w-3xl mb-10">
      <h2 class="text-2xl font-semibold text-indigo-800 mb-3">Become a Host</h2>
      <p class="mb-5 text-gray-600">Have a property to share? List your home on Staynest and earn extra income!</p>

      <% if (!isLoggedIn) { %>
        <a href="/signup" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg">Sign Up to List Your Home</a>
      <% } else if (user && user.userType === 'host') { %>
        <a href="/host/register" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg">List Your Home</a>
      <% } else { %>
        <a href="/signup" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg">Become a Host</a>
      <% } %>
    </div>

    <!-- CTA -->
    <% if (isLoggedIn) { %>
      <a href="/home_list" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-6 rounded-lg">Get Started</a>
    <% } else { %>
      <a href="/login" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-6 rounded-lg">Login to Get Started</a>
    <% } %>

  </div>

  <%- include('../partials/footer')%>
</body>
</html>
