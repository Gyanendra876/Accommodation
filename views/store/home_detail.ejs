<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-800">
  <!-- NAV (included separately, not styled here) -->
  <%- include('../partials/nav') %>

  <!-- PRODUCT WRAPPER -->
  <div class="max-w-6xl mx-auto mt-24 px-4 grid grid-cols-1 md:grid-cols-[360px_1fr] gap-8">

    <!-- LEFT: Gallery -->
    <aside class="flex flex-col gap-4">
      <div class="sticky top-24 bg-white rounded-xl shadow-md p-4">
        <img src="<%= home.photourl %>" alt="Main image" class="w-full h-[500px] object-cover rounded-lg">
      </div>
    </aside>

    <!-- RIGHT: Details -->
    <main class="flex flex-col gap-6">

      <!-- Title -->
      <h1 class="text-2xl font-bold text-gray-900"><%= home.houseName %></h1>

      <!-- Meta Info -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center bg-blue-50 text-blue-700 font-semibold px-3 py-2 rounded-md">
          <span class="text-lg"><%= home.Rating %></span><span class="text-gray-500 ml-1">/ 5</span>
        </div>

        <div class="text-right">
          <div class="text-2xl font-bold text-gray-900">₹<%= home.pricepernight %> <span class="text-gray-500 text-base font-normal">/ night</span></div>
          <div class="text-gray-500 text-sm"><%= home.Location %></div>
        </div>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="flex flex-wrap gap-4">
        <form action="/favourite-list" method="post">
          <input type="hidden" name="id" value="<%= home._id %>">
          <button type="submit" class="px-6 py-2 rounded-md font-semibold bg-amber-500 hover:bg-amber-600 text-white shadow-sm">
            Add to Favourite
          </button>
        </form>

        <form action="/bookings" method="POST">
          <input type="hidden" name="id" value="<%= home._id %>">
          <button type="submit" class="px-6 py-2 rounded-md font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-sm">
            Book Now
          </button>
        </form>
      </div>

      <!-- OFFERS -->
      <section class="bg-white shadow-md rounded-xl p-5">
        <h2 class="font-bold text-lg mb-2 text-gray-800">Available offers</h2>
        <ul class="list-disc ml-5 text-gray-700 space-y-1">
          <li>Bank Offer: 5% cashback (example)</li>
          <li>Special Price: Extra 7% off</li>
          <li>Seasonal discount / coupon (example)</li>
        </ul>
      </section>

      <!-- ABOUT -->
      <section class="bg-white shadow-md rounded-xl p-5">
        <h2 class="font-bold text-lg mb-2 text-gray-800">About this place</h2>
        <p class="text-gray-700">
          <%= home.description ? home.description : "Discover this beautiful stay. Comfortable, clean and well-located." %>
        </p>
      </section>

      <!-- INFO -->
      <section class="bg-white shadow-md rounded-xl p-5">
        <h2 class="font-bold text-lg mb-2 text-gray-800">Things to know</h2>
        <ul class="list-disc ml-5 text-gray-700 space-y-1">
          <li>Guests aged 18+ welcome, up to 4 guests.</li>
          <li>Moderate activity level, beginner-friendly.</li>
          <li>Bring water and your camera.</li>
          <li>Accessible — contact host for details.</li>
        </ul>
      </section>

      <!-- RATINGS & REVIEWS -->
      <section class="bg-white shadow-md rounded-xl p-5">
        <h2 class="font-bold text-lg mb-4 text-gray-800">Ratings & Reviews</h2>

        <div class="flex flex-wrap gap-6 items-start">
          <!-- Left: Overall -->
          <div class="text-center">
            <div class="text-3xl font-bold text-gray-900"><%= home.Rating %></div>
            <div class="text-gray-500 text-sm">66 Ratings & 7 Reviews</div>
          </div>

          <!-- Right: Bars -->
          <div class="flex-1 space-y-2">
            <% const bars = [
              {stars:5, width:'68%', count:31},
              {stars:4, width:'24%', count:11},
              {stars:3, width:'15%', count:8},
              {stars:2, width:'8%', count:7},
              {stars:1, width:'10%', count:9}
            ]; %>
            <% bars.forEach(b => { %>
              <div class="flex items-center gap-2">
                <span class="text-sm text-gray-600 w-6"><%= b.stars %>★</span>
                <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full bg-green-500 rounded-full" style="width:<%= b.width %>"></div>
                </div>
                <span class="text-sm text-gray-600 w-6 text-right"><%= b.count %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Reviews -->
        <div class="mt-6 space-y-4">
          <article class="border-t border-gray-100 pt-4">
            <div class="font-semibold text-gray-800">Iddriss Ali <span class="text-gray-500 text-sm ml-2">Certified Buyer • 5 months ago</span></div>
            <div class="text-sm text-gray-500 mb-1">2 ★ — Expected a better product</div>
            <p class="text-gray-700">Bad</p>
          </article>

          <article class="border-t border-gray-100 pt-4">
            <div class="font-semibold text-gray-800">Pushkar Mitra <span class="text-gray-500 text-sm ml-2">Certified Buyer • 2 months ago</span></div>
            <div class="text-sm text-gray-500 mb-1">5 ★ — Brilliant</div>
            <p class="text-gray-700">Excellent stay — comfortable, clean, great host.</p>
          </article>
        </div>
      </section>
    </main>
  </div>

  <!-- FOOTER -->
  <footer class="mt-20 text-center text-sm text-gray-500 py-6 border-t border-gray-200 bg-white/70 backdrop-blur">
    © 2025 StayNest — All rights reserved
  </footer>
</body>
</html>
