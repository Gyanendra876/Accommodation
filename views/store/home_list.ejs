<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-[Poppins]">

  <!-- ✅ Navbar -->
  <%- include('../partials/nav') %>

  <!-- ✅ Main Container -->
  <!-- Added pt-24 to push content below sticky navbar -->
  <div class="max-w-7xl mx-auto px-4 pt-24 pb-10 flex flex-col items-center">

    <!-- ✅ Features -->
    <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 w-full mb-10">
      <div class="bg-white rounded-xl shadow-md p-6 text-center hover:-translate-y-1 transition">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Comfortable Stays</h3>
        <p class="text-gray-600 text-sm">Well-furnished homes with premium amenities.</p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 text-center hover:-translate-y-1 transition">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Verified Hosts</h3>
        <p class="text-gray-600 text-sm">Every property is reviewed for safety and trust.</p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 text-center hover:-translate-y-1 transition">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">24/7 Support</h3>
        <p class="text-gray-600 text-sm">We’re here whenever you need us.</p>
      </div>
    </section>

 

    <!-- ✅ Search Form -->
    <form action="/search" method="GET" class="flex flex-wrap justify-center gap-4 mb-10">
      <input type="text" name="location" placeholder="Enter Location" class="border border-gray-300 rounded-md px-4 py-2 w-48 focus:ring-2 focus:ring-indigo-400" />
      <input type="number" name="minPrice" placeholder="Min Price" class="border border-gray-300 rounded-md px-4 py-2 w-40 focus:ring-2 focus:ring-indigo-400" />
      <input type="number" name="maxPrice" placeholder="Max Price" class="border border-gray-300 rounded-md px-4 py-2 w-40 focus:ring-2 focus:ring-indigo-400" />
      <input type="number" name="minRating" placeholder="Min Rating" class="border border-gray-300 rounded-md px-4 py-2 w-36 focus:ring-2 focus:ring-indigo-400" />
      <button type="submit" class="bg-indigo-600 text-white px-5 py-2 rounded-md hover:bg-indigo-700 transition">Search</button>
    </form>

    <!-- ✅ Homes Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
      <% Registration.forEach(home => { %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:-translate-y-1 transition">
          <img src="<%= home.photourl %>" alt="House Image" class="w-full h-56 object-cover" />
          <div class="p-5">
            <h2 class="text-lg font-semibold text-gray-800"><%= home.houseName %></h2>
            <p class="text-gray-600 mt-1">₹<%= home.pricepernight %> / night</p>
            <p class="text-gray-600 mt-1">📍 <%= home.Location %></p>
            <p class="text-gray-600 mt-1">⭐ <%= home.Rating %></p>
          </div>
          <div class="flex justify-between items-center px-5 pb-5">
            <a href="/home_list/<%= home._id %>" class="text-indigo-600 hover:text-indigo-800 font-medium">Details</a>
            <form action="/bookings" method="POST" class="inline">
              <input type="hidden" name="id" value="<%= home._id %>">
              <button type="submit" class="bg-indigo-600 text-white px-4 py-1.5 rounded-md hover:bg-indigo-700 transition">Book</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ✅ Footer -->
  <%- include('../partials/footer') %>

</body>
</html>
