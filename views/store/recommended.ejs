<!DOCTYPE html>
<html>
<head>
  <title><%= pageTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <h1 class="text-3xl text-center mt-6 font-bold text-blue-600">🏠 Recommended For You</h1>

  <% if (message) { %>
    <p class="text-center text-red-500 mt-4"><%= message %></p>
  <% } %>

  <div class="grid grid-cols-3 gap-6 mt-10 mx-20">
    <% homes.forEach(home => { %>
      <div class="bg-white p-4 rounded-lg shadow hover:shadow-lg transition">
        <img src="<%= home.photourl %>" class="w-full h-48 object-cover rounded-lg mb-2" alt="<%= home.houseName %>">
        <h2 class="text-lg font-semibold"><%= home.houseName %></h2>
        <p class="text-gray-600"><%= home.Location %></p>
        <p class="text-blue-600 font-semibold">₹<%= home.pricepernight %>/night</p>
        <p class="text-yellow-500">⭐ <%= home.Rating %></p>
      </div>
    <% }) %>
  </div>

  <div class="text-center mt-8">
    <a href="/home_list" class="bg-blue-500 text-white px-4 py-2 rounded">← Back to All Homes</a>
  </div>
</body>
</html>
