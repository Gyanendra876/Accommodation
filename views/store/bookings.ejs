<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-poppins">
  <!-- ✅ Tailwind Navbar -->
  <%- include('../partials/nav') %>

  <!-- Main Content -->
  <main class="bookings-wrapper pt-24">
    <h1 class="page-title text-center text-3xl font-semibold mb-6">My Bookings</h1>

    <% if (bookings.length === 0) { %>
      <p class="text-center text-gray-500">You have no bookings yet.</p>
    <% } else { %>
      <section class="bookings-list flex flex-col gap-6 w-11/12 max-w-4xl mx-auto mb-12">
        <% bookings.forEach(booking => { 
          const home = booking.home || booking;
        %>
          <div class="booking-card flex flex-col sm:flex-row bg-white rounded-xl shadow hover:shadow-lg overflow-hidden transition">
            <div class="booking-image flex-none w-full sm:w-64 h-48">
              <img src="<%= home.photourl %>" alt="Home Image" class="w-full h-full object-cover" />
            </div>
            <div class="booking-details flex-1 p-5">
              <h2 class="text-xl font-semibold text-gray-800 mb-2"><%= home.houseName %></h2>
              <p class="price text-pink-600 font-semibold mb-1">₹<%= home.pricepernight %> / night</p>
              <p class="info text-gray-500 text-sm mb-2">⭐ <%= home.Rating %> • <%= home.Location %></p>
              <p class="desc text-gray-600 text-sm mb-4"><%= home.description || "No description available." %></p>
              <div class="booking-actions flex items-center gap-3">
                <a href="/home_list/<%= home._id %>" class="view-btn bg-pink-500 text-white px-4 py-2 rounded-md hover:bg-pink-600 transition text-sm">View Details</a>
                <% if (!booking.isPaid) { %>
                  <button 
                    class="pay-btn bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition text-sm"
                    data-amount="<%= home.pricepernight %>"
                    data-housename="<%= home.houseName %>"
                    data-homeid="<%= home._id %>">Pay Now</button>
                <% } else { %>
                  <span class="paid-status text-green-600 font-semibold text-sm">✅ Paid</span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </section>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Razorpay Script -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    document.querySelectorAll('.pay-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        const amount = btn.getAttribute('data-amount');
        const housename = btn.getAttribute('data-housename');
        const homeId = btn.getAttribute('data-homeid');

        fetch('/razorpay/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        })
        .then(res => res.json())
        .then(order => {
          if (!order.id) return alert('Order creation failed!');
          const options = {
            key: "rzp_test_FkhYGi7Wa4Thcy",
            amount: order.amount,
            currency: order.currency,
            name: "Staynest",
            description: housename + " Booking Payment",
            order_id: order.id,
            handler: function (response){
              window.location.href = "/booking/paid?homeId=" + homeId + "&paymentId=" + response.razorpay_payment_id;
            },
            theme: { color: "#f05a7e" }
          };
          const rzp1 = new Razorpay(options);
          rzp1.open();
        });
      });
    });

    
  </script>
</body>
</html>
