<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

    <%- include('../partials/nav') %>




  <!-- ✅ TITLE -->
  <h1 class="text-center text-3xl font-bold mt-24 text-gray-800">Favourite List</h1>

  <!-- ✅ FAVOURITE CARDS -->
  <div class="max-w-7xl mx-auto flex flex-wrap justify-center gap-6 px-4 py-10">
    <% favouriteHomes.forEach(home => { %>
      <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition transform hover:-translate-y-1 w-72 overflow-hidden text-center pb-4">
        <img src="<%= home.photourl %>" alt="House Image" class="w-full h-44 object-cover rounded-t-2xl">

        <div class="flex flex-col gap-2 px-4 mt-3 text-gray-600 text-sm">
          <div class="flex items-center justify-center gap-1 text-pink-500 font-medium">
            ⭐ <span class="text-gray-700 font-semibold"><%= home.houseName %></span>
          </div>

          <div class="flex items-center justify-center gap-1">
             <span>₹<%= home.pricepernight %> / night</span>
          </div>

          <div class="flex items-center justify-center gap-1">
             <span><%= home.Location %></span>
          </div>

          <div class="flex items-center justify-center gap-1">
            🌟 <span><%= home.Rating %></span>
          </div>

          <div class="flex items-center justify-between mt-3">
            <a href="/home_list/<%= home._id %>"
               class="bg-blue-600 text-white px-3 py-1.5 rounded-md text-sm hover:bg-blue-700 flex items-center gap-1 transition">
               Details
            </a>

            <form action="/favorites/delete/<%= home._id %>" method="POST">
              <button type="submit"
                      class="bg-pink-500 text-white px-3 py-1.5 rounded-md text-sm hover:bg-pink-600 flex items-center gap-1 transition">
                 Remove
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- ✅ FOOTER -->
  <%- include('../partials/footer') %>

  <script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  </script>

</body>
</html>
